{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile with authentic Maharashtra district and premium cosmetics",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "displayName": { "type": "string", "maxLength": 60 },
        "photoURL": { "type": "string", "maxLength": 1000 },
        "district": { "type": "string", "maxLength": 50 },
        "bio": { "type": "string", "maxLength": 300 },
        "isOnline": { "type": "boolean" },
        "subscriptionStatus": { "type": "string", "enum": ["none", "active", "expired"] },
        "subscriptionPlan": { "type": "string", "enum": ["1_month", "3_months", "6_months"] },
        "subscriptionStart": { "type": "string" },
        "subscriptionEnd": { "type": "string" },
        "vipLevel": { "type": "number" },
        "vipExp": { "type": "number" },
        "coins": { "type": "number" },
        "totalRecharged": { "type": "number" },
        "lifetimeCoinsPurchased": { "type": "number" },
        "lifetimeCoinsSpent": { "type": "number" },
        "lifetimeCoinsReceived": { "type": "number" },
        "equippedBubble": { "type": "string", "maxLength": 80 },
        "equippedFrame": { "type": "string", "maxLength": 80 },
        "equippedSeatFrame": { "type": "string", "maxLength": 80 },
        "equippedBadge": { "type": "string", "maxLength": 80 },
        "equippedEntryEffect": { "type": "string", "maxLength": 80 },
        "equippedProfileEffect": { "type": "string", "maxLength": 80 },
        "equippedNameEffect": { "type": "string", "maxLength": 80 },
        "isProfilePrivate": { "type": "boolean" },
        "hideFriendsList": { "type": "boolean" },
        "hideOnlineStatus": { "type": "boolean" },
        "friendsCount": { "type": "number" }
      },
      "required": ["uid", "displayName", "district"]
    },
    "Friendship": {
      "title": "Friendship",
      "description": "Friend connection with mutual status, friend details and privacy",
      "type": "object",
      "properties": {
        "friendId": { "type": "string", "maxLength": 128 },
        "friendName": { "type": "string", "maxLength": 80 },
        "friendPhoto": { "type": "string", "maxLength": 1000 },
        "friendDistrict": { "type": "string", "maxLength": 50 },
        "friendVipLevel": { "type": "number" },
        "createdAt": { "type": "string" }
      },
      "required": ["friendId", "friendName"]
    },
    "PremiumSubscription": {
      "title": "PremiumSubscription",
      "description": "Subscription transaction record after real payment verification",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128 },
        "planId": { "type": "string", "enum": ["1_month", "3_months", "6_months"] },
        "amount": { "type": "number" },
        "paymentReference": { "type": "string", "maxLength": 128 },
        "status": { "type": "string", "enum": ["verified", "pending", "failed"] },
        "startDate": { "type": "string" },
        "endDate": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["userId", "planId", "amount", "status"]
    },
    "RoomGift": {
      "title": "RoomGift",
      "description": "Real gift sent between authentic users in a chat or voice room",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "districtId": { "type": "string", "maxLength": 50 },
        "giftId": { "type": "string", "maxLength": 80 },
        "giftName": { "type": "string", "maxLength": 80 },
        "giftIcon": { "type": "string", "maxLength": 80 },
        "senderId": { "type": "string", "maxLength": 128 },
        "senderName": { "type": "string", "maxLength": 80 },
        "recipientId": { "type": "string", "maxLength": 128 },
        "recipientName": { "type": "string", "maxLength": 80 },
        "createdAt": { "type": "string" }
      },
      "required": ["districtId", "giftId", "senderId", "recipientId"]
    },
    "CoinTransaction": {
      "title": "CoinTransaction",
      "description": "Immutable ledger record for all coin wallet credits, debits and adjustments",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "type": { "type": "string", "enum": ["PURCHASE", "GIFT_SENT", "GIFT_RECEIVED", "REFUND", "ADMIN_ADJUSTMENT"] },
        "amount": { "type": "number" },
        "balanceAfter": { "type": "number" },
        "description": { "type": "string", "maxLength": 200 },
        "referenceId": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "userId", "type", "amount", "balanceAfter"]
    },
    "GiftCatalogItem": {
      "title": "GiftCatalogItem",
      "description": "Admin configurable virtual gift catalog item with cultural theme and coin price",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 80 },
        "nameMr": { "type": "string", "maxLength": 80 },
        "nameEn": { "type": "string", "maxLength": 80 },
        "previewIcon": { "type": "string", "maxLength": 80 },
        "coinPrice": { "type": "number" },
        "culturalTheme": { "type": "string", "maxLength": 80 },
        "animation": { "type": "string", "maxLength": 80 },
        "active": { "type": "boolean" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "nameMr", "coinPrice"]
    },
    "GameMatch": {
      "title": "GameMatch",
      "description": "1v1 multiplayer game session with synchronized moves and scores",
      "type": "object",
      "properties": {
        "matchId": { "type": "string", "maxLength": 128 },
        "gameId": { "type": "string", "maxLength": 60 },
        "status": { "type": "string", "enum": ["searching", "opponent_found", "ready", "countdown", "playing", "finished", "abandoned", "cancelled"] },
        "player1Uid": { "type": "string", "maxLength": 128 },
        "player2Uid": { "type": "string", "maxLength": 128 },
        "turn": { "type": "string", "maxLength": 128 },
        "winnerUid": { "type": "string", "maxLength": 128 },
        "isDraw": { "type": "boolean" },
        "createdAt": { "type": "string" }
      },
      "required": ["matchId", "gameId", "status", "player1Uid"]
    },
    "GameQueueEntry": {
      "title": "GameQueueEntry",
      "description": "Matchmaking queue entry for a player seeking a 1v1 game",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "gameId": { "type": "string", "maxLength": 60 },
        "displayName": { "type": "string", "maxLength": 80 },
        "district": { "type": "string", "maxLength": 50 },
        "status": { "type": "string", "enum": ["waiting", "matched"] },
        "createdAt": { "type": "string" }
      },
      "required": ["uid", "gameId", "status"]
    },
    "GamePlayerStats": {
      "title": "GamePlayerStats",
      "description": "Player Game Zone statistics, XP, rating, and achievements",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128 },
        "gamesPlayed": { "type": "number" },
        "wins": { "type": "number" },
        "losses": { "type": "number" },
        "xp": { "type": "number" },
        "rating": { "type": "number" }
      },
      "required": ["userId", "gamesPlayed", "wins", "xp"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profiles including premium subscription states and coin balance"
    },
    "/users/{userId}/friends/{friendId}": {
      "schema": "Friendship",
      "description": "Friends of the user with friendship details"
    },
    "/users/{userId}/transactions/{txnId}": {
      "schema": "CoinTransaction",
      "description": "User specific coin ledger transactions"
    },
    "/transactions/{txnId}": {
      "schema": "CoinTransaction",
      "description": "System-wide immutable coin transaction ledger"
    },
    "/giftCatalog/{giftId}": {
      "schema": "GiftCatalogItem",
      "description": "Virtual gift catalog items and price configurations"
    },
    "/subscriptions/{subId}": {
      "schema": "PremiumSubscription",
      "description": "Verified subscription purchase records"
    },
    "/districts/{districtId}/gifts/{giftId}": {
      "schema": "RoomGift",
      "description": "Real-time gifts sent between real participants"
    },
    "/districts/{districtId}/messages/{messageId}": {
      "schema": "ChatMessage",
      "description": "Text messages sent within a district"
    },
    "/gameMatches/{matchId}": {
      "schema": "GameMatch",
      "description": "Real-time 1v1 multiplayer game match session state and moves"
    },
    "/gameQueue/{queueId}": {
      "schema": "GameQueueEntry",
      "description": "Active real-time matchmaking queue entries for 1v1 challenges"
    },
    "/gameStats/{userId}": {
      "schema": "GamePlayerStats",
      "description": "User game statistics, XP, rating, wins and achievements"
    }
  }
}
