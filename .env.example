# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# RAZORPAY_KEY_ID: Razorpay Key ID for payments (starts with rzp_test_ or rzp_live_)
RAZORPAY_KEY_ID=""

# RAZORPAY_KEY_SECRET: Razorpay Key Secret for backend verification
RAZORPAY_KEY_SECRET=""

# UPI_MERCHANT_ID: UPI ID for direct scan & pay recharge (e.g., 7620363213@ybl)
UPI_MERCHANT_ID="7620363213@ybl"

# UPI_MERCHANT_NAME: Business / Bank account name displayed during UPI checkout
UPI_MERCHANT_NAME="IndusInd Bank - 3213"

# AGORA_APP_ID: Agora RTC App ID (from console.agora.io)
AGORA_APP_ID=""

# AGORA_APP_CERTIFICATE: Agora App Certificate for secure server-side token generation
AGORA_APP_CERTIFICATE=""
