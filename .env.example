# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# GOOGLE_PAY_MERCHANT_ID: Google Pay Merchant ID from Google Pay Business Console (optional in test mode)
GOOGLE_PAY_MERCHANT_ID=""

# GOOGLE_PAY_MERCHANT_NAME: Business display name in Google Pay checkout
GOOGLE_PAY_MERCHANT_NAME="IndusInd Bank - 3213"

# GOOGLE_PAY_UPI_ID: Primary Google Pay UPI ID / Merchant VPA
GOOGLE_PAY_UPI_ID="7620363213@ybl"

# GOOGLE_PAY_ENV: Google Pay Environment ('TEST' or 'PRODUCTION')
GOOGLE_PAY_ENV="PRODUCTION"

# GOOGLE_PAY_MCC: Merchant Category Code (Default: 5812)
GOOGLE_PAY_MCC="5812"

# UPI_MERCHANT_ID: UPI ID for direct scan & pay recharge (e.g., 7620363213@ybl)
UPI_MERCHANT_ID="7620363213@ybl"

# UPI_MERCHANT_NAME: Business / Bank account name displayed during UPI checkout
UPI_MERCHANT_NAME="IndusInd Bank - 3213"

# AGORA_APP_ID: Agora RTC App ID (from console.agora.io)
AGORA_APP_ID=""

# AGORA_APP_CERTIFICATE: Agora App Certificate for secure server-side token generation
AGORA_APP_CERTIFICATE=""

# LIVE STREAMING (LiveKit Cloud / Self-hosted SFU)
FEATURE_LIVE=true
# LIVEKIT_URL: WebSocket URL for your LiveKit project (e.g. wss://your-subdomain.livekit.cloud)
LIVEKIT_URL=""
# LIVEKIT_API_KEY: LiveKit project API key from https://cloud.livekit.io
LIVEKIT_API_KEY=""
# LIVEKIT_API_SECRET: LiveKit project API secret
LIVEKIT_API_SECRET=""

PAYMENT_GATEWAY_KEY_ID=""
PAYMENT_GATEWAY_KEY_SECRET=""
PAYMENT_MODE="test"
