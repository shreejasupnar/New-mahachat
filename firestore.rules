rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // User profiles
    match /users/{userId} {
      allow read: if true;
      allow create, update: if request.auth != null && request.auth.uid == userId;
      allow delete: if false;

      // User friends subcollection
      match /friends/{friendId} {
        allow read: if true;
        allow write: if request.auth != null && (request.auth.uid == userId || request.auth.uid == friendId);
      }

      // User coin transactions ledger
      match /transactions/{txnId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow create: if request.auth != null && request.auth.uid == userId;
        allow update, delete: if false;
      }
    }

    // District chat messages
    match /districts/{districtId}/messages/{messageId} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.senderId == request.auth.uid;
      allow update: if request.auth != null && (resource.data.senderId == request.auth.uid || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reported', 'reportCount']));
      allow delete: if request.auth != null && resource.data.senderId == request.auth.uid;
    }

    // Voice room participants
    match /districts/{districtId}/voiceRooms/{roomId}/participants/{userId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Voice room in-room rolling messages & events
    match /districts/{districtId}/voiceRooms/{roomId}/messages/{messageId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow delete: if request.auth != null;
    }

    // Voice room speaker requests (hands raised)
    match /districts/{districtId}/voiceRooms/{roomId}/speakerRequests/{requestId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Voice room bans (moderation)
    match /districts/{districtId}/voiceRooms/{roomId}/bans/{targetUid} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Direct chats between two users
    match /directChats/{chatId} {
      allow read, write: if request.auth != null;
      
      match /messages/{messageId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null && request.resource.data.senderId == request.auth.uid;
      }
    }

    // User reports for moderation
    match /reports/{reportId} {
      allow create: if request.auth != null;
      allow read: if request.auth != null;
      allow update, delete: if false;
    }

    // Real-time gifts sent between real participants in a district room
    match /districts/{districtId}/gifts/{giftId} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.senderId == request.auth.uid;
      allow delete: if request.auth != null && resource.data.senderId == request.auth.uid;
    }

    // Room events like entry effects
    match /districts/{districtId}/roomEvents/{eventId} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
    }

    // Verified subscription transaction records
    match /subscriptions/{subId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }

    // VIP Recharge transactions
    match /recharges/{rechargeId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }

    // Global immutable coin transactions ledger
    match /transactions/{txnId} {
      allow read: if request.auth != null && (resource.data.userId == request.auth.uid || resource.data.senderId == request.auth.uid || resource.data.recipientId == request.auth.uid);
      allow create: if request.auth != null && (request.resource.data.userId == request.auth.uid || request.resource.data.senderId == request.auth.uid);
      allow update, delete: if false;
    }

    // Configurable virtual gift catalog
    match /giftCatalog/{giftId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Admin asset management
    match /adminAssets/{assetId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // ==========================================
    // MAHACHAT GAME ZONE REAL-TIME COLLECTIONS
    // ==========================================

    // 1v1 Real-time Game Matches
    match /gameMatches/{matchId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if false;
    }

    // Real-time Matchmaking Waiting Queue
    match /gameQueue/{queueId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow update, delete: if request.auth != null;
    }

    // Player Game Zone Statistics & Achievements
    match /gameStats/{userId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // ==========================================
    // MAHACHAT LIVE STREAMING REAL-TIME COLLECTIONS
    // ==========================================

    match /live_streams/{streamId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if request.auth != null && resource.data.hostUid == request.auth.uid;

      match /messages/{messageId} {
        allow read: if true;
        allow create: if request.auth != null;
        allow update, delete: if false;
      }

      match /participants/{participantId} {
        allow read: if true;
        allow write: if request.auth != null;
      }

      match /guest_requests/{requestId} {
        allow read: if true;
        allow write: if request.auth != null;
      }

      match /stage_guests/{guestId} {
        allow read: if true;
        allow write: if request.auth != null;
      }
    }

    match /pk_battles/{pkId} {
      allow read: if true;
      allow create, update: if request.auth != null;
      allow delete: if request.auth != null;
    }
  }
}
